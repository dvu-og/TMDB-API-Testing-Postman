        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Check status code\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Test 2: Check response time\r",
              "\r",
              "pm.test(\"Response time is below 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "// Test 3: Check response is JSON\r",
              "\r",
              "pm.test(\"Response is JSON\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "// Test 4: Check results exist\r",
              "\r",
              "pm.test(\"Movies are available\", function () {\r",
              "    let data = pm.response.json();\r",
              "\r",
              "    pm.expect(data.results).to.be.an(\"array\");\r",
              "    pm.expect(data.results.length).to.be.above(0);\r",
              "});"
            ],
